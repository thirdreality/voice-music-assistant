#!/bin/sh
# udhcpc owns the DHCP server list. ntp-apply owns config and ntpd.
[ "$interface" = wlan0 ] || exit 0
case "$1" in
    bound|renew) ;;
    deconfig) ntpsrv= ;;
    *) exit 0 ;;
esac
(
    flock -x 9 || exit 1
    defaults=/etc/default/ntpd
    # Option 42 is an IP list, not executable shell text.
    case "$ntpsrv" in *[!0-9.\ :a-fA-F]*) exit 1 ;; esac
    old=$(sed -n 's/^NTPSERVERS_DHCP="\(.*\)"/\1/p' "$defaults")
    if [ "$old" != "$ntpsrv" ]; then
        tmp=$(mktemp "$defaults.XXXXXX") || exit 1
        trap 'rm -f "$tmp"' EXIT HUP INT TERM
        sed '/^NTPSERVERS_DHCP=/d' "$defaults" > "$tmp"
        printf 'NTPSERVERS_DHCP="%s"\n' "$ntpsrv" >> "$tmp"
        chmod 644 "$tmp" && mv "$tmp" "$defaults" || exit 1
    fi
) 9>/tmp/ha_ntp.lock
# Always apply: policy may have changed even when the lease did not.
/usr/share/thirdreality/script/ntp-apply &
