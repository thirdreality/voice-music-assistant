#!/bin/sh
# Local link monitoring only. Internet reachability is deliberately not probed.
. /usr/share/thirdreality/script/network-policy.sh
DEVICE_CONF=/data/conf/device.json
rm -f /tmp/net_disconnected

update_net_state() (
    flock -x 9 || exit 1
    tmp=$(mktemp /data/conf/device.net.XXXXXX) || exit 1
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    jq --arg state "$1" '.network.status = $state' "$DEVICE_CONF" > "$tmp" &&
        mv "$tmp" "$DEVICE_CONF"
) 9>/tmp/device_info.lock

current_state=
failures=0
while :; do
    if wifi_local_ready; then
        failures=0
        next_state=connected
    else
        failures=$((failures + 1))
        next_state=disconnected
        # Debounce a transient lost link/IP once we were connected.
        if [ "$current_state" = connected ] && [ "$failures" -lt 2 ]; then
            next_state=connected
        fi
    fi
    if [ "$next_state" != "$current_state" ]; then
        if update_net_state "$next_state"; then
            current_state=$next_state
            echo "Local network: $current_state"
            [ "$current_state" != connected ] || ensure_dns_config
        fi
    fi
    sleep 3
done
