+#if !defined(_WIN32)
+struct whisper_context * whisper_init_from_file_mmap_no_state(const char * path_model, struct whisper_context_params params) {
+    WHISPER_LOG_INFO("%s: mapping model from '%s'\n", __func__, path_model);
+
+    const int fd = open(path_model, O_RDONLY | O_CLOEXEC);
+    if (fd < 0) {
+        WHISPER_LOG_ERROR("%s: failed to open '%s'\n", __func__, path_model);
+        return nullptr;
+    }
+    struct stat st;
+    if (fstat(fd, &st) != 0 || st.st_size <= 0) {
+        close(fd);
+        return nullptr;
+    }
+    const size_t len = (size_t) st.st_size;
+    void * addr = mmap(nullptr, len, PROT_READ, MAP_PRIVATE, fd, 0);
+    close(fd);
+    if (addr == MAP_FAILED) {
+        WHISPER_LOG_ERROR("%s: mmap failed for '%s'\n", __func__, path_model);
+        return nullptr;
+    }
+
+    struct map_ctx { const uint8_t * base; size_t size; size_t pos; };
+    map_ctx mc = { (const uint8_t *) addr, len, 0 };
+
+    whisper_model_loader loader = {};
+    loader.context = &mc;
+    loader.read = [](void * c, void * out, size_t n) {
+        auto * m = (map_ctx *) c;
+        const size_t k = m->pos + n <= m->size ? n : m->size - m->pos;
+        if (k > 0 && out != nullptr) memcpy(out, m->base + m->pos, k);
+        m->pos += k;
+        return k;
+    };
+    loader.eof   = [](void * c) { auto * m = (map_ctx *) c; return m->pos >= m->size; };
+    loader.close = [](void *) {};
+
+    whisper_mmap_pending() = { addr, len, &mc.pos };
+    auto * ctx = whisper_init_with_params_no_state(&loader, params);
+    whisper_mmap_pending() = {};
+
+    if (ctx == nullptr) {
+        munmap(addr, len);
+        return nullptr;
+    }
+    ctx->mmap_pos   = nullptr;
+    ctx->path_model = path_model;
+    madvise(addr, len, MADV_RANDOM);
+    return ctx;
+}
+#endif
